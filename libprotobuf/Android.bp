    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libc++",
        "liblog",
    ],
    target: {
        android_arm64: {
            srcs: ["libprotobuf-cpp-lite-21.12.so"],
        },
    },
    compile_multilib: "64",
