cc_prebuilt_library_shared {
    name: "libprotobuf-cpp-full-21.12-vendorcompat",
    stem: "libprotobuf-cpp-full-21.12",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libc++",
        "liblog",
        "libz",
    ],
    target: {
        android_arm64: {
            srcs: ["libprotobuf-cpp-full-21.12.so"],
        },
    },
    compile_multilib: "64",
}

